# Optional SEO verification (paste values from each webmaster console)
# Google Search Console → Settings → Ownership verification → HTML tag
VITE_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools → Add site → HTML Meta Tag (content value only)
VITE_BING_SITE_VERIFICATION=

# ChatAI live widget (public assistant id from app.nightzeros.com)
VITE_CHATAI_ASSISTANT_ID=
# Optional — defaults to https://app.nightzeros.com
VITE_CHATAI_API_URL=https://app.nightzeros.com

